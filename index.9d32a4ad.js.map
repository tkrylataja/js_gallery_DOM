"use strict";
var miniList = document.querySelector("#thumbs");
var bigPhotoElem = document.querySelector("#largeImg");
miniList.addEventListener("click", function(clickEvent) {
    clickEvent.preventDefault();
    var link = clickEvent.target.closest(".list-item__link");
    if (!link) return;
    bigPhotoElem.src = link.href;
});

